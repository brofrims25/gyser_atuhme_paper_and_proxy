<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mynetwork.bedrockbypass</groupId>
        <artifactId>bedrockbypass-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bedrockbypass-velocity</artifactId>
    <packaging>jar</packaging>
    <name>BedrockAuthBypass-Velocity</name>

    <properties>
        <!--
          PENTING: meng-compile modul ini butuh JDK 25 di komputer/CI-mu,
          BUKAN cuma untuk menjalankan proxy-nya. Sebabnya BUKAN cuma
          annotation processor-nya velocity-api (yang sudah dimatikan lewat
          <proc>none> di bawah + velocity-plugin.json manual) - ternyata
          SELURUH isi jar velocity-api 4.0.0-SNAPSHOT sendiri (semua class
          publik yang kita import: @Plugin, @Subscribe, ProxyServer, dst)
          memang di-compile pakai JDK 25 (class file version 69). javac
          versi lama (mis. JDK 21, cuma baca sampai class file 65) akan
          gagal dengan error "bad class file ... class file has wrong
          version 69.0, should be 65.0" begitu source kita meng-import
          class apa pun dari library ini - walau kode kita sendiri cuma
          menyasar bytecode target Java 17 (opsi compiler "release"
          bernilai 17, hasil .jar-nya tetap jalan di JVM 17+).

          Kalau proxy-mu masih pakai velocity-api versi lama
          (3.4.0-SNAPSHOT ke bawah, biasanya dari sebelum pertengahan
          2026), JDK 21 cukup - tapi itu berarti proxy-mu juga belum
          pindah ke arsitektur baru yang butuh Java 25 untuk DIJALANKAN.
          Cek versi persis yang cocok dengan build Velocity-mu di:
            https://repo.papermc.io/service/rest/repository/browse/maven-public/com/velocitypowered/velocity-api/
        -->
        <velocity.api.version>4.0.0-SNAPSHOT</velocity.api.version>
        <floodgate.api.version>2.2.5-SNAPSHOT</floodgate.api.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>opencollab-snapshot-repo</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>${velocity.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Floodgate WAJIB sudah terpasang sebagai plugin terpisah di proxy ini.

                 Exclusion di bawah WAJIB ada: transitive dependency-nya
                 (org.geysermc.cumulus:cumulus, dipakai untuk fitur "Forms" yang
                 TIDAK kita pakai) jar-nya kadang tidak ter-publish/hilang di
                 repo manapun untuk snapshot tertentu, dan bikin build gagal
                 dengan error "Could not find artifact ...cumulus...". Karena
                 plugin ini cuma memanggil isFloodgatePlayer(), aman untuk
                 di-exclude. -->
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>${floodgate.api.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.geysermc.cumulus</groupId>
                    <artifactId>cumulus</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Annotation processing DIMATIKAN dengan sengaja: velocity-api
                         4.0.0-SNAPSHOT ada di classpath (scope provided) dan javac bisa
                         auto-discover annotation processor-nya lewat META-INF/services
                         walau annotationProcessorPaths tidak diisi. Processor itu butuh
                         JDK 25 untuk dimuat. Karena velocity-plugin.json sudah ditulis
                         manual di src/main/resources, kita tidak butuh processor itu
                         sama sekali - proc=none memastikan javac tidak pernah mencoba
                         memuatnya, jadi build ini jalan normal di JDK 17/21 ke atas. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
